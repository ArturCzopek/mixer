# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API Keys; new-style keys)
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_… (replaces the legacy anon key); safe in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… (replaces the legacy service_role key). Server only: all DB writes use it
SUPABASE_SECRET_KEY=

# Signs the session cookie (jose). Generate (any OS): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Public base URL for the Steam OpenID return URL. Optional: without it the request's own origin is
# used (right for Vercel preview deploys). Set it for Production (e.g. https://mixer.vercel.app).
APP_URL=

# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# https://developers.faceit.com (server-side Data API key)
FACEIT_API_KEY=
# https://leetify.com/app/developer (display only, never stored)
LEETIFY_API_KEY=

# Comma-separated SteamID64s bootstrapped as admins
ADMIN_STEAM_IDS=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/keepalive
CRON_SECRET=

# --- Dev tooling only (cloud sandbox), not needed in Vercel ---
# Personal access token (supabase.com/dashboard/account/tokens) to apply migrations via the Management API
SUPABASE_ACCESS_TOKEN=
