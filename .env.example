# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: all DB writes go through server code with this key
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie (jose). Generate: openssl rand -base64 32
SESSION_SECRET=

# Public base URL, used for the Steam OpenID return URL (e.g. http://localhost:3000)
APP_URL=http://localhost:3000

# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# https://developers.faceit.com (server-side Data API key)
FACEIT_API_KEY=
# https://leetify.com/app/developer (display only, never stored)
LEETIFY_API_KEY=

# Comma-separated SteamID64s bootstrapped as admins
ADMIN_STEAM_IDS=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/keepalive
CRON_SECRET=
